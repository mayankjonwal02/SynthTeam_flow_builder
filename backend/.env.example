# Copy to backend/.env and fill in. See docs/configuration.md.

# ── Required ──────────────────────────────────────────
# Inside docker compose use the service names (postgres, redis);
# when running the backend directly on your machine use localhost.
DATABASE_URL=postgresql+asyncpg://synthuser:synthpass@postgres:5432/synthdb
REDIS_URL=redis://redis:6379/0

CLERK_SECRET_KEY=sk_test_xxx
CLERK_PUBLISHABLE_KEY=pk_test_xxx

# Fernet key for encrypting saved DB credentials. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ── Optional ──────────────────────────────────────────
# Local LLMs. From inside docker use host.docker.internal.
# Use the port your Ollama server listens on (default 11434).
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Default provider keys (nodes can also supply their own)
GROQ_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# MISTRAL_API_KEY=
# TAVILY_API_KEY=

# Default history cap for the workflow memory_config node
AI_MEMORY_DEFAULT_MAX_MESSAGES=200
# Messages included in Agent Builder Planner/Builder/Reviewer prompts
AGENT_BUILDER_CONTEXT_MESSAGES=60
