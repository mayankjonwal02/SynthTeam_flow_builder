DATABASE_URL=postgresql+asyncpg://synthuser:synthpass@postgres:5432/synthdb
REDIS_URL=redis://redis:6379/0

# Clerk
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# LLM providers
# When backend runs in Docker and Ollama runs on the host, use host.docker.internal.
# Use the port your Ollama server listens on (default 11434; e.g. 11500 if you changed it).
OLLAMA_BASE_URL=http://host.docker.internal:11500

# Optional (only needed if you use Groq as provider)
GROQ_API_KEY=

# Encryption (override in production)
ENCRYPTION_KEY=generate-a-fernet-key-here

# AI memory defaults (workflow `memory_config` node)
AI_MEMORY_DEFAULT_MAX_MESSAGES=200

# Agent-builder pipeline context size (messages included in Planner/Builder/Reviewer prompts)
AGENT_BUILDER_CONTEXT_MESSAGES=60
